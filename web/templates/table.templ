package templates

import "github.com/Struck713/brakarr/media"

templ Table(items []media.Media) {
	<table class="table">
		<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Title</th>
				<th scope="col">Format</th>
				<th scope="col">Bit Depth</th>
				<th scope="col">Size</th>
			</tr>
		</thead>
		<tbody>
			for index, item := range items {
                <tr>
                    <th scope="row">{index}</th>
                    <td>{item.Title}</td>
                    <td>{item.Format}</td>
                    <td>{item.BitDepth}</td>
                    <td>{item.Size}</td>
			    </tr>
            }
		</tbody>
	</table>
}
