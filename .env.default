# Copy to .env and edit. Real environment variables take precedence over .env.

# Required: directory to scan for media
CRAWL_PATH=

# Optional (defaults shown)
# CRAWL_EXTENSIONS=.mkv
# CRAWL_INTERVAL=10m        # 0 = scan once at startup
# MIN_FILE_AGE=30s          # skip files modified more recently (still copying)
# WORK_DIR=./work
# DB_PATH=app.db
# VAAPI_DEVICE=/dev/dri/renderD128
# QUALITY=22                # HEVC QP, 0-51 (lower = better quality)
# WORKERS=1
# LISTEN_ADDR=127.0.0.1:1323
# REPLACE_ORIGINALS=false   # true = overwrite the source with the verified transcode
# LOG_LEVEL=info            # debug|info|warn|error
