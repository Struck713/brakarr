# Copy to .env and edit. Real environment variables take precedence over .env.

# Required: directory to scan for media
CRAWL_PATH=

# Optional (defaults shown)
# Only .mkv and .mp4 are supported
# CRAWL_EXTENSIONS=.mkv,.mp4

# How often to scan. 0 = scan once at startup
# CRAWL_INTERVAL=10m

# Skip files modified more recently than this (still copying)
# MIN_FILE_AGE=30s

# WORK_DIR=./work
# DB_PATH=app.db
# VAAPI_DEVICE=/dev/dri/renderD128

# HEVC QP, 0-51 (lower = better quality)
# QUALITY=22

# WORKERS=1
# LISTEN_ADDR=127.0.0.1:1323

# debug|info|warn|error
# LOG_LEVEL=info

# Wait to replace files that are still hardlinked (e.g. a torrent still seeding)
# until only one link remains. Replacing them early uses extra disk space.
# SKIP_HARDLINKED=true

# Tell Sonarr and/or Radarr to rescan after a file is replaced, so their stored
# size and codec stay correct. Each URL and API key must be set together.
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=

# local=remote[,local=remote] for when the apps see different paths than Brakarr
# ARR_PATH_MAP=
