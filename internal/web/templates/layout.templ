package templates


const (
	navLibrary  = "library"
	navActivity = "activity"
)

func currentPage(active bool) templ.Attributes {
	if active {
		return templ.Attributes{"aria-current": "page"}
	}
	return nil
}

// layout loads htmx from <head> because hx-boost swaps the body, and a script
// inside the body would run again on every page change.
templ layout(active, title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - Brakarr</title>
			<link rel="stylesheet" href="/static/brakarr.css"/>
			<script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
		</head>
		<body>
			<input id="nav-toggle" class="nav-toggle" type="checkbox" aria-label="Show navigation"/>
			<header class="app-header">
				<label class="nav-button" for="nav-toggle">
					@icon("menu")
				</label>
				<a class="brand" href="/" hx-boost="true">
					@icon("logo")
					<span>Brakarr</span>
				</a>
			</header>
			<div class="app-body">
				<nav class="sidebar" aria-label="Main" hx-boost="true">
					@navLink("/", "library", "Library", active == navLibrary)
					@navLink("/activity", "activity", "Activity", active == navActivity)
				</nav>
				<main class="content">
					<div class="toolbar">
						<h1>{ title }</h1>
					</div>
					<div class="page">
						{ children... }
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ navLink(href, iconName, label string, active bool) {
	<a class="nav-link" href={ templ.SafeURL(href) } { currentPage(active)... }>
		@icon(iconName)
		<span>{ label }</span>
	</a>
}

templ icon(name string) {
	<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "logo":
				<path fill="currentColor" d="M4 4h16l-6 8 6 8H4l6-8z"></path>
			case "menu":
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			case "library":
				<rect x="3" y="4" width="18" height="16" rx="2"></rect>
				<path d="M8 4v16M16 4v16M3 9h5M3 15h5M16 9h5M16 15h5"></path>
			case "activity":
				<path d="M3 12h4l3-8 4 16 3-8h4"></path>
			case "check":
				<path d="M5 13l4 4L19 7"></path>
			case "x":
				<path d="M6 6l12 12M18 6L6 18"></path>
			case "clock":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7v5l3 2"></path>
			case "play":
				<path fill="currentColor" d="M7 5l12 7-12 7z"></path>
			case "skip":
				<path d="M5 5l10 7-10 7zM19 5v14"></path>
			case "pause":
				<path d="M8 5v14M16 5v14"></path>
			case "retry":
				<path d="M4 4v6h6M20 20v-6h-6"></path>
				<path d="M20 9a8 8 0 0 0-14-3l-2 4M4 15a8 8 0 0 0 14 3l2-4"></path>
			case "left":
				<path d="M15 5l-7 7 7 7"></path>
			case "right":
				<path d="M9 5l7 7-7 7"></path>
		}
	</svg>
}
