package templates

import (
	"fmt"
	"strconv"

	"github.com/Struck713/brakarr/internal/media"
	"github.com/Struck713/brakarr/internal/pool"
	"github.com/Struck713/brakarr/internal/transcode"
)

func formatBytes(size int64) string {
	const unit = 1024

	if size < unit {
		return fmt.Sprintf("%d B", size)
	}

	div, exp := int64(unit), 0
	for n := size / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %ciB", float64(size)/float64(div), "KMGTPE"[exp])
}

templ ActiveJobs(jobs []*pool.Job) {
	if len(jobs) == 0 {
		<div class="empty">No active transcodes.</div>
	} else {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th scope="col" class="col-icon"><span class="sr-only">State</span></th>
						<th scope="col">Title</th>
						<th scope="col">Format</th>
						<th scope="col">Encoded</th>
						<th scope="col">Speed</th>
						<th scope="col">FPS</th>
						<th scope="col">Frame</th>
						<th scope="col">Bitrate</th>
						<th scope="col">Output</th>
						<th scope="col">Duplicate</th>
						<th scope="col">Dropped</th>
						<th scope="col">Progress</th>
					</tr>
				</thead>
				<tbody>
					for _, job := range jobs {
						@jobRow(job.Media, job.Progress())
					}
				</tbody>
			</table>
		</div>
	}
}

templ jobRow(item *media.Media, status *transcode.Progress) {
	<tr>
		@jobIcon(status)
		<td class="col-title" title={ item.Path }>{ item.Name }</td>
		<td>{ item.Format } · { item.BitDepth }-bit</td>
		if status == nil {
			<td class="muted" colspan="9">Starting…</td>
		} else {
			<td>{ status.OutTime }</td>
			<td>{ status.Speed }</td>
			<td>{ fmt.Sprintf("%.1f", status.Fps) }</td>
			<td>{ strconv.FormatInt(status.Frame, 10) }</td>
			<td>{ status.Bitrate }</td>
			<td>{ formatBytes(status.TotalSize) }</td>
			<td>{ strconv.FormatInt(status.DupFrames, 10) }</td>
			<td>{ strconv.FormatInt(status.DropFrames, 10) }</td>
			<td class="col-progress">
				if item.Duration > 0 {
					@jobProgress(status.Percent(item.Duration))
				}
			</td>
		}
	</tr>
}

templ jobIcon(status *transcode.Progress) {
	if status == nil {
		<td class="col-icon status-warning" title="Starting">
			@icon("clock")
		</td>
	} else if status.Done {
		<td class="col-icon status-success" title="Done">
			@icon("check")
		</td>
	} else {
		<td class="col-icon status-info" title="Transcoding">
			@icon("play")
		</td>
	}
}

templ jobProgress(percent float64) {
	<div class="progress">
		<progress max="100" value={ fmt.Sprintf("%.1f", percent) } aria-label="Transcode progress"></progress>
		<span class="muted">{ fmt.Sprintf("%.1f%%", percent) }</span>
	</div>
}
