package templates

import (
	"encoding/hex"
	"fmt"

	"github.com/Struck713/brakarr/internal/media"
)

// MediaList is one page of the library table.
type MediaList struct {
	Items []media.Media
	Page  int
	Pages int
	Total int
}

func shortHash(hash []byte) string {
	const visibleBytes = 6

	if len(hash) > visibleBytes {
		hash = hash[:visibleBytes]
	}
	return hex.EncodeToString(hash)
}

func panelURL(page int) string {
	return fmt.Sprintf("/media?page=%d", page)
}

func retryURL(hash []byte, page int) string {
	return fmt.Sprintf("/media/%s/retry?page=%d", hex.EncodeToString(hash), page)
}

func statusView(status media.Status) (label, kind, iconName string) {
	switch status {
	case media.StatusFailed:
		return "Failed", "danger", "x"
	case media.StatusRunning:
		return "Running", "info", "play"
	case media.StatusSkipped:
		return "Skipped", "neutral", "skip"
	case media.StatusComplete:
		return "Complete", "success", "check"
	case media.StatusDeferred:
		return "Waiting", "accent", "pause"
	default:
		return "Pending", "warning", "clock"
	}
}

// MediaPanel is a self-refreshing fragment that keeps the current page across polls.
templ MediaPanel(list MediaList) {
	<div id="media-panel" hx-get={ panelURL(list.Page) } hx-trigger="every 5s" hx-swap="outerHTML">
		if list.Total == 0 {
			<div class="empty">No media found yet.</div>
		} else {
			@table(list.Items, list.Page)
			@pager(list)
		}
	</div>
}

templ table(items []media.Media, page int) {
	<div class="table-wrap">
		<table class="table">
			<thead>
				<tr>
					<th scope="col" class="col-icon"><span class="sr-only">State</span></th>
					<th scope="col">Title</th>
					<th scope="col">Format</th>
					<th scope="col">Bit Depth</th>
					<th scope="col">Size</th>
					<th scope="col">Hash</th>
					<th scope="col">Status</th>
					<th scope="col" class="col-end"><span class="sr-only">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				for _, item := range items {
					{{ label, kind, iconName := statusView(item.Status) }}
					<tr>
						<td class={ "col-icon", "status-" + kind }>
							@icon(iconName)
						</td>
						<td class="col-title" title={ item.Path }>{ item.Name }</td>
						<td>{ item.Format }</td>
						<td>{ item.BitDepth }</td>
						<td>{ formatBytes(item.Size) }</td>
						<td><code title={ hex.EncodeToString(item.Hash) }>{ shortHash(item.Hash) }</code></td>
						<td><span class={ "label", "label-" + kind } title={ item.Error }>{ label }</span></td>
						<td class="col-end">
							if item.Status == media.StatusFailed {
								<button
									class="icon-button"
									title="Retry"
									aria-label={ "Retry " + item.Name }
									hx-post={ retryURL(item.Hash, page) }
									hx-target="#media-panel"
									hx-swap="outerHTML"
								>
									@icon("retry")
								</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ pager(list MediaList) {
	<nav class="pager" aria-label="Media pages">
		if list.Pages > 1 {
			<div class="pager-controls">
				<button
					class="icon-button"
					aria-label="Previous page"
					hx-get={ panelURL(list.Page - 1) }
					hx-target="#media-panel"
					hx-swap="outerHTML"
					disabled?={ list.Page <= 1 }
				>
					@icon("left")
				</button>
				<span>{ fmt.Sprint(list.Page) } / { fmt.Sprint(list.Pages) }</span>
				<button
					class="icon-button"
					aria-label="Next page"
					hx-get={ panelURL(list.Page + 1) }
					hx-target="#media-panel"
					hx-swap="outerHTML"
					disabled?={ list.Page >= list.Pages }
				>
					@icon("right")
				</button>
			</div>
		}
		<div class="pager-total">Total files: { fmt.Sprint(list.Total) }</div>
	</nav>
}
