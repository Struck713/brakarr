package templates

import (
	"encoding/hex"
	"fmt"
	"strconv"

	"github.com/Struck713/brakarr/internal/media"
)

func shortHash(hash []byte) string {
	const visibleBytes = 6

	if len(hash) > visibleBytes {
		hash = hash[:visibleBytes]
	}
	return hex.EncodeToString(hash)
}

templ Table(items []media.Media) {
	if len(items) == 0 {
		<p class="text-muted">No media logged yet.</p>
	} else {
		<div class="table-responsive bg-white border rounded">
			<table class="table table-hover align-middle mb-0">
				<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col">Hash</th>
						<th scope="col">Title</th>
						<th scope="col">Format</th>
						<th scope="col">Bit Depth</th>
						<th scope="col">Status</th>
					</tr>
				</thead>
				<tbody>
					for index, item := range items {
						<tr>
							<th scope="row">{ strconv.Itoa(index + 1) }</th>
							<td><code title={ hex.EncodeToString(item.Hash) }>{ shortHash(item.Hash) }</code></td>
							<td>{ item.Name }</td>
							<td>{ item.Format }</td>
							<td>{ fmt.Sprint(item.BitDepth) }</td>
							<td>
                                switch item.Status {
                                case media.StatusFailed:
                                    <span class="badge bg-error">Failed</span>
                                case media.StatusRunning:
                                    <span class="badge bg-warning">Running</span>
                                case media.StatusSkipped:
                                    <span class="badge bg-warning">Skipped</span>
                                case media.StatusComplete:
                                    <span class="badge bg-warning">Skipped</span>
                                default:
                                    <span class="badge bg-gray">Pending</span>
                                }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}