package templates

import "github.com/Struck713/brakarr/internal/pool"

templ LibraryPage(list MediaList) {
	@layout(navLibrary, "Library") {
		@MediaPanel(list)
	}
}

templ ActivityPage(jobs []*pool.Job) {
	@layout(navActivity, "Activity") {
		<div hx-get="/jobs" hx-trigger="every 2s">
			@ActiveJobs(jobs)
		</div>
	}
}
