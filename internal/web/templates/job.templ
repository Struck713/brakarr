package templates

import (
	"fmt"
	"strconv"

	"github.com/Struck713/brakarr/internal/transcode"
	"github.com/Struck713/brakarr/internal/media"
)


templ stat(label, value string) {
	<div class="col">
		<dt class="small text-muted fw-normal">{ label }</dt>
		<dd class="mb-0">{ value }</dd>
	</div>
}

func formatBytes(size int64) string {
	const unit = 1024

	if size < unit {
		return fmt.Sprintf("%d B", size)
	}

	div, exp := int64(unit), 0
	for n := size / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %ciB", float64(size)/float64(div), "KMGTPE"[exp])
}

templ ActiveJob(media *media.Media, progress *transcode.Progress) {
	if media == nil {
		<div class="card">
			<div class="card-body text-muted">No active job.</div>
		</div>
	} else {
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-start gap-3">
					<div>
						<h3 class="h6 mb-1">{ media.Name }</h3>
						<small class="text-muted">{ media.Format } · { fmt.Sprint(media.BitDepth) }-bit</small>
					</div>
					@jobBadge(progress)
				</div>
				if progress != nil {
					<dl class="row row-cols-2 row-cols-md-4 g-3 mt-2 mb-0">
						@stat("Encoded time", progress.OutTime)
						@stat("Speed", progress.Speed)
						@stat("FPS", fmt.Sprintf("%.1f", progress.Fps))
						@stat("Frame", strconv.FormatInt(progress.Frame, 10))
						@stat("Bitrate", progress.Bitrate)
						@stat("Output size", formatBytes(progress.TotalSize))
						@stat("Duplicate frames", strconv.FormatInt(progress.DupFrames, 10))
						@stat("Dropped frames", strconv.FormatInt(progress.DropFrames, 10))
					</dl>
				}
			</div>
		</div>
	}
}

templ jobBadge(progress *transcode.Progress) {
	if progress == nil {
		<span class="badge bg-secondary">Starting</span>
	} else if progress.Done {
		<span class="badge bg-success">Done</span>
	} else {
		<span class="badge bg-primary">Transcoding</span>
	}
}